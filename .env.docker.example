# Mau bien moi truong cho Docker — copy thanh .env.docker roi dien gia tri that.
# .env.docker KHONG duoc commit (da nam trong .gitignore).

# --- Build-time (compose truyen vao build args) ---
# NEXT_PUBLIC_* se bi inline vao client bundle luc build.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# DATABASE_URL: dung Transaction Pooler (port 6543) cho container. @ trong password -> %40
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# --- Runtime (chi doc luc chay, khong inline vao bundle) ---
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
NEXTAUTH_SECRET=<sinh bang: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000
ADMIN_EMAIL=you@example.com
RESEND_API_KEY=
